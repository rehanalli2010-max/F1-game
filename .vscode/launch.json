{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch F1 Game",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Start F1 Game Server"
    },
    {
      "name": "Start Server Only (Node.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal"
    }
  ]
}
