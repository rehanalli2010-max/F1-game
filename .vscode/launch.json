{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch F1 Game (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Program Files (x86)\\Google\\Chrome\\Application\\chrome.exe",
      "preLaunchTask": "Start F1 Game Server"
    },
    {
      "name": "Launch F1 Game (Default Browser)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "args": ["--open"],
      "console": "integratedTerminal"
    },
    {
      "name": "Launch F1 Game (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "runtimeExecutable": "C:\\Program Files (x86)\\Microsoft\\Edge\\Application\\msedge.exe",
      "preLaunchTask": "Start F1 Game Server"
    },
    {
      "name": "Start Server Only (Node.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal"
    }
  ]
}
